-- ==========================================
-- OVERDRIVE H NATIVE PLUGIN (RESET BUTTON + AUTO CMDS)
-- ==========================================
local shared = odh_shared_plugins
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local CoreGui = game:GetService("CoreGui")
local TextChatService = game:GetService("TextChatService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Tworzenie nowej zakładki w menu Overdrive H
local my_tab = shared.CreateTab("MMV Admin & Actions", "axioriasolver/testplugin/refs/heads/main/icon")

-- Bezpieczne wysyłanie komend na czacie
local function sendChatCommand(cmd)
    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
            if channel then channel:SendAsync(cmd) end
        else
            local sayMessageRequest = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents") 
                and ReplicatedStorage.DefaultChatSystemChatEvents:FindFirstChild("SayMessageRequest")
            if sayMessageRequest then sayMessageRequest:FireServer(cmd, "All") end
        end
    end)
end

-- Detekcja końca rundy / lobby
local function isInLobbyOrEnded()
    local success, result = pcall(function()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if playerGui then
            for _, gui in ipairs(playerGui:GetDescendants()) do
                if gui:IsA("TextLabel") or gui:IsA("TextButton") then
                    local text = string.lower(gui.Text)
                    if text:find("intermission") or text:find("voting") or text:find("victory") or text:find("defeat") or text:find("round over") or text:find("waiting") then
                        return true
                    end
                end
            end
        end
        return false
    end)
    return success and result
end

----------------------------------------------------
-- TWORZENIE PRZYCISKU RESET NA EKRANIE (GUI)
----------------------------------------------------
local screenGui = CoreGui:FindFirstChild("MMV_ScreenResetGui")
if not screenGui then
    screenGui = Instance.new("ScreenGui")
    screenGui.Name = "MMV_ScreenResetGui"
    screenGui.Parent = CoreGui
    screenGui.ResetOnSpawn = false
end

local screenResetBtn = Instance.new("TextButton")
screenResetBtn.Size = UDim2.new(0, 110, 0, 45)
screenResetBtn.Position = UDim2.new(0.02, 0, 0.4, 0) -- Pozycja na ekranie
screenResetBtn.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
screenResetBtn.Text = "💀 RESET"
screenResetBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
screenResetBtn.TextSize = 16
screenResetBtn.Font = Enum.Font.SourceSansBold
screenResetBtn.Active = true
screenResetBtn.Draggable = true -- Możesz go przeciągać palcem po ekranie
screenResetBtn.Visible = false -- Domyślnie ukryty, dopóki nie włączysz ON w Overdrive
screenResetBtn.Parent = screenGui

local btnCorner = Instance.new("UICorner")
btnCorner.CornerRadius = UDim.new(0, 8)
btnCorner.Parent = screenResetBtn

-- Akcja po kliknięciu przycisku na ekranie
screenResetBtn.MouseButton1Click:Connect(function()
    pcall(function()
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
            LocalPlayer.Character:FindFirstChildOfClass("Humanoid").Health = 0
            shared.Notify("Character Reset!", 1.5)
        end
    end)
end)

----------------------------------------------------
-- SEKCJA 1: PLAYER ACTIONS (RESET OVERLAY ON/OFF)
----------------------------------------------------
local actions_section = my_tab:AddSection("Player Actions", "SCREEN OVERLAY")

-- Przełącznik ON/OFF do pokazywania przycisku na ekranie
actions_section:AddToggle("Show Reset Button on Screen", function(state)
    screenResetBtn.Visible = state
    if state then
        shared.Notify("Reset Button Enabled!", 2)
    else
        shared.Notify("Reset Button Hidden!", 2)
    end
end)

-- Bezpośredni przycisk resetu w samym menu Overdrive
actions_section:AddButton("💀 Reset Character Now", function()
    pcall(function()
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
            LocalPlayer.Character:FindFirstChildOfClass("Humanoid").Health = 0
            shared.Notify("Character Reset!", 2)
        end
    end)
end)

----------------------------------------------------
-- SEKCJA 2: AUTO COMMAND SENDER (MMV ADMIN)
----------------------------------------------------
local admin_section = my_tab:AddSection("Auto Command Sender", "LOOP /MAP /SHERIFF /MURDERER")

local mapName = "Milbase"
admin_section:AddTextBox("Map Name", function(text)
    if text and text ~= "" then
        mapName = text
    end
end)

local autoMap = false
admin_section:AddToggle("Auto Send /map", function(state)
    autoMap = state
end)

local autoSheriff = false
admin_section:AddToggle("Auto Send /sheriff", function(state)
    autoSheriff = state
end)

local autoMurderer = false
admin_section:AddToggle("Auto Send /murderer", function(state)
    autoMurderer = state
end)

----------------------------------------------------
-- PĘTLA WYKONYWANIA KOMEND CO NOWĄ RUNDĘ
----------------------------------------------------
task.spawn(function()
    local sentThisRound = false
    while true do
        if isInLobbyOrEnded() then
            sentThisRound = false -- Resetuje się w lobby/po rundzie
        else
            if not sentThisRound then
                task.wait(1.5) -- Odczekaj na rozpoczęcie rundy
                
                if autoMap and mapName ~= "" then
                    sendChatCommand("/map " .. mapName)
                    task.wait(0.5)
                end
                if autoSheriff then
                    sendChatCommand("/sheriff " .. LocalPlayer.Name)
                    task.wait(0.5)
                end
                if autoMurderer then
                    sendChatCommand("/murderer " .. LocalPlayer.Name)
                end
                
                sentThisRound = true -- Komendy wysłane w tej rundzie
            end
        end
        task.wait(1)
    end
end)
